# Gateway
PORT=3000
NODE_ENV=development
REDIS_URL=redis://localhost:6379
BACKEND_URL=http://localhost:4000
# Required — no safe default is checked into this repo. For local `npm run
# dev`, any value works. For `docker compose up`, Compose reads this same
# variable from a root .env file (this file, copied and filled in) to
# substitute into docker-compose.yml — generate a real value, don't reuse
# an example:
#   openssl rand -hex 24
ADMIN_API_KEY=replace-with-a-real-generated-secret

# Backend (dummy upstream)
# PORT=4000  (set separately when running apps/backend)

# Dashboard (Vite reads this at build/dev time, not runtime)
# VITE_GATEWAY_URL=http://localhost:3000
